# member-api configuration. Copy to .env for local development; .env is
# never committed. Values here are placeholders.

# Listen address of the member API.
MEMBER_API_ADDR=127.0.0.1:8081

# The service vault's private API and the API key it issued to this
# application.
SERVICE_VAULT_URL=http://127.0.0.1:8080
SERVICE_VAULT_API_KEY=replace-me

# Secret shared with the service vault for webhook signatures
# (HMAC over timestamp.body).
WEBHOOK_SECRET=replace-me

# DynamoDB table prefix (local: DynamoDB Local endpoint).
DYNAMODB_TABLE_PREFIX=member-service-dev
DYNAMODB_ENDPOINT=http://127.0.0.1:18000
