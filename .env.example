# member-api configuration (README "Configuration"). Copy to .env for
# local development; .env is never committed. Values here are
# placeholders.

# Listen address of the member API.
MEMBER_API_ADDR=127.0.0.1:8081

# The service vault's private API, its TLS key pin ("sha256/..."; the
# stack's TlsPinParameterName in SSM) and the API key it accepts from
# this application.
SERVICE_VAULT_URL=https://127.0.0.1:8443
SERVICE_VAULT_PIN=REPLACE_ME
SERVICE_VAULT_API_KEY=REPLACE_ME

# Secret shared with the service vault for webhook signatures (HMAC over
# timestamp.body), at least 32 bytes.
WEBHOOK_SECRET=REPLACE_ME

# Key for the hashes of email addresses and codes, at least 32 bytes.
MEMBER_API_PEPPER=REPLACE_ME

# DynamoDB table (local: DynamoDB Local or LocalStack endpoint).
DYNAMODB_TABLE=member-service-dev
DYNAMODB_ENDPOINT=http://127.0.0.1:4566

# Exactly one: SES sender of a verified domain identity, or a directory
# the codes are written to (local development only).
# MAIL_FROM=no-reply@staging.vettid.org
MAIL_DIR=./local-mail

# Header the edge sets with the visitor's address (CloudFront:
# CloudFront-Viewer-Address). Empty: the connection's remote address.
CLIENT_IP_HEADER=

# Secret the edge sends as X-Origin-Verify (required with
# CLIENT_IP_HEADER); requests without it are refused.
ORIGIN_VERIFY_SECRET=
